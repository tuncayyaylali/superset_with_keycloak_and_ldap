# ==============================================================================
# Environment Configuration Template: Apache Superset + Keycloak + OpenLDAP
# Copy to .env for local adjustments or use in automated pipelines.
# ==============================================================================

# Target Kubernetes Namespace
K8S_NAMESPACE=superset-bi

# ------------------------------------------------------------------------------
# OpenLDAP Configuration
# ------------------------------------------------------------------------------
LDAP_ORGANISATION=Example Org
LDAP_DOMAIN=example.org
LDAP_BASE_DN=dc=example,dc=org
LDAP_ADMIN_PASSWORD=adminpassword
LDAP_CONFIG_PASSWORD=configpassword
LDAP_SERVICE_HOST=openldap.superset-bi.svc.cluster.local
LDAP_SERVICE_PORT=389

# ------------------------------------------------------------------------------
# Keycloak PostgreSQL Storage Configuration
# ------------------------------------------------------------------------------
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloakpassword
KEYCLOAK_DB_HOST=keycloak-db.superset-bi.svc.cluster.local
KEYCLOAK_DB_PORT=5432

# ------------------------------------------------------------------------------
# Keycloak Application Configuration
# ------------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=analytics-realm
KEYCLOAK_SERVICE_HOST=keycloak.superset-bi.svc.cluster.local
KEYCLOAK_SERVICE_PORT=8080

# ------------------------------------------------------------------------------
# Superset OIDC Client Credentials
# ------------------------------------------------------------------------------
SUPERSET_OIDC_CLIENT_ID=superset
SUPERSET_OIDC_CLIENT_SECRET=superset-client-secret-12345
SUPERSET_OIDC_REDIRECT_URI=http://localhost:8088/oauth-authorized/keycloak

# ------------------------------------------------------------------------------
# Superset Application & Metadata Database Configuration
# ------------------------------------------------------------------------------
SUPERSET_SECRET_KEY=superset-secret-key-change-in-production-12345
SUPERSET_DB_HOST=superset-db.superset-bi.svc.cluster.local
SUPERSET_DB_PORT=5432
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=supersetpassword
SUPERSET_DB_NAME=superset

# ------------------------------------------------------------------------------
# Analytics Data Warehouse Configuration (fact_orders & RLS)
# ------------------------------------------------------------------------------
ANALYTICS_DW_HOST=superset-db.superset-bi.svc.cluster.local
ANALYTICS_DW_PORT=5432
ANALYTICS_DW_USER=superset
ANALYTICS_DW_PASSWORD=supersetpassword
ANALYTICS_DW_NAME=analytics_dw

# ------------------------------------------------------------------------------
# Superset Caching & Celery Broker (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=superset-redis.superset-bi.svc.cluster.local
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# phpLDAPadmin Web GUI Configuration
# ------------------------------------------------------------------------------
PHPLDAPADMIN_PORT=80
PHPLDAPADMIN_HTTPS=false
PHPLDAPADMIN_SERVER_ADMIN=admin@example.org


