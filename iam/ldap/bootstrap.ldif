# ==============================================================================
# LDAP Seed Directory Structure for Apache Superset + Keycloak
# Base DN: dc=example,dc=org
# ==============================================================================

# Organizational Units
dn: ou=users,dc=example,dc=org
objectClass: top
objectClass: organizationalUnit
ou: users
description: Active Users Directory

dn: ou=groups,dc=example,dc=org
objectClass: top
objectClass: organizationalUnit
ou: groups
description: Business Intelligence & Role Groups

# ------------------------------------------------------------------------------
# User Entries (Default Password: Password123!)
# ------------------------------------------------------------------------------

# 1. BI Administrator (maps to Superset 'Admin')
dn: uid=john.admin,ou=users,dc=example,dc=org
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: john.admin
cn: John Admin
givenName: John
sn: Admin
mail: john.admin@example.org
userPassword: Password123!

# 2. BI Analyst (maps to Superset 'Alpha')
dn: uid=alice.analyst,ou=users,dc=example,dc=org
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: alice.analyst
cn: Alice Analyst
givenName: Alice
sn: Analyst
mail: alice.analyst@example.org
userPassword: Password123!

# 3. Finance Viewer (maps to Superset 'Gamma' + 'Finance_Viewers')
dn: uid=bob.finance,ou=users,dc=example,dc=org
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: bob.finance
cn: Bob Finance
givenName: Bob
sn: Finance
mail: bob.finance@example.org
userPassword: Password123!

# 4. Sales Viewer (maps to Superset 'Gamma' + 'Sales_Viewers')
dn: uid=carol.sales,ou=users,dc=example,dc=org
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: carol.sales
cn: Carol Sales
givenName: Carol
sn: Sales
mail: carol.sales@example.org
userPassword: Password123!

# ------------------------------------------------------------------------------
# Group Entries (groupOfNames)
# ------------------------------------------------------------------------------

dn: cn=bi-admins,ou=groups,dc=example,dc=org
objectClass: top
objectClass: groupOfNames
cn: bi-admins
description: Full BI Platform Administrators
member: uid=john.admin,ou=users,dc=example,dc=org

dn: cn=bi-analysts,ou=groups,dc=example,dc=org
objectClass: top
objectClass: groupOfNames
cn: bi-analysts
description: BI Analysts with SQL Lab and Dataset authoring access
member: uid=alice.analyst,ou=users,dc=example,dc=org

dn: cn=bi-finance-viewers,ou=groups,dc=example,dc=org
objectClass: top
objectClass: groupOfNames
cn: bi-finance-viewers
description: Finance dashboard viewers constrained by Department FIN RLS
member: uid=bob.finance,ou=users,dc=example,dc=org

dn: cn=bi-sales-viewers,ou=groups,dc=example,dc=org
objectClass: top
objectClass: groupOfNames
cn: bi-sales-viewers
description: Sales dashboard viewers constrained by Department SLS RLS
member: uid=carol.sales,ou=users,dc=example,dc=org

